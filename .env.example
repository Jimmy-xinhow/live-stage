# 網站網址（部署後填實際網域）
APP_BASE_URL=https://example.com
# 資料庫；不填就用內嵌 PGlite（開發用）
DATABASE_URL=
# Railway 這類單一啟動指令的平台：啟動時自動跑遷移
MIGRATE_ON_BOOT=true
# 示範資料（正式營運請設 false）
SEED_DEMO=false
# 平台管理後台密碼
ADMIN_PASSWORD=
# 管理員的 LINE userId，可多個用逗號分隔
ADMIN_LINE_USER_IDS=
# 展示用：模擬付款、免 LINE 登入（正式環境務必 false）
ECPAY_ALLOW_MOCK=false
DEV_LOGIN=false
# 加密與簽章
SESSION_SECRET=
APP_ENCRYPTION_KEY=
# LINE
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_MESSAGING_ACCESS_TOKEN=
LINE_MESSAGING_CHANNEL_SECRET=
NEXT_PUBLIC_LIFF_ID=
NEXT_PUBLIC_LINE_OA_URL=
# 平台自己的金流（只用於賣點數）
PLATFORM_GATEWAY=mock
PLATFORM_MERCHANT_ID=
PLATFORM_HASH_KEY=
PLATFORM_HASH_IV=
PAYMENT_ENV=stage
# 直播聊天室（選用）
YOUTUBE_API_KEY=
